{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:mobile": "vite build --base ./ --outDir dist-mobile",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "test:mobile": "node scripts/verify-mobile.mjs",
    "test:map": "node scripts/verify-participation-map.mjs",
    "test:portal-data": "node scripts/verify-portal-test-data.mjs",
    "test:browser": "node scripts/verify-browser-ui.mjs",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "research:export": "node scripts/research-operator.mjs",
    "test:research-operator": "node scripts/research-operator.tests.mjs",
    "build:hosted": "vite build --base /",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "test:icons": "node scripts/verify-app-icons.mjs",
    "test:dashboard": "node scripts/verify-research-dashboard.mjs",
    "test:specialty-content": "node scripts/generate-specialty-narrative-migration.mjs",
    "generate:specialty-content-migration": "node scripts/generate-specialty-narrative-migration.mjs --write",
    "test:supabase-runtime": "node scripts/verify-supabase-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.21.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "1.63.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
