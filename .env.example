# Public browser configuration. Prefer the current publishable key format.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use a separate Supabase development project for previews and local QA.
# Never point synthetic load tests or preview deployments at the research database.
# Frontend hosting: npm run build:hosted (root); npm run build (GitHub Pages /Q-pro/).

# Legacy fallback only. Never put a secret/service-role key in a VITE_* variable.
# VITE_SUPABASE_ANON_KEY=replace_with_legacy_anon_key
